# Supabase dashboard > Project Settings > API. These two values are public.
# URL must include https:// (use the Project URL, not the dashboard URL or a key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: Phase 4 validated evidence upload/cleanup worker and demo provisioning.
# Use the project's secret key (or legacy service_role key). NEVER use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DEMO_RESIDENT_EMAIL=
DEMO_RESIDENT_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Canonical public website for sign-up/password recovery callbacks.
SITE_URL=https://ayosdito.vercel.app

# Web Push: generate locally with npm.cmd run push:keys -- --write-env.
# Public key is safe for the client; keep the private key and job secret server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://ayosdito.vercel.app
PUSH_CRON_SECRET=
